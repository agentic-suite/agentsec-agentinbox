# Field-test environment. Copy to `.env` and edit.
# Results are written to field-test/<FT_VERSION>/results/<run-id>/.

# --- version / results root ---------------------------------------------------
FT_VERSION=v0.1.0

# --- image pin ----------------------------------------------------------------
FT_TAG=local

# --- stack behavior -----------------------------------------------------------
STACK_TIMEOUT=180
STACK_KEEP=0
# 1 = the Docker SUT is required. agentinbox cases run inside the container so
# every case has one reproducible environment.
FT_DOCKER=1

# --- deep verification --------------------------------------------------------
# FT_STRICT_GROUNDING=1 (default): a PASS with no grounded assertion fails.
FT_STRICT_GROUNDING=1
# FT_STRICT_BLOCKED=1 (default): a BLOCKED case makes run-all exit non-zero,
# because a release cannot be tagged while a required field case is blocked.
FT_STRICT_BLOCKED=1

# --- freeze guard -------------------------------------------------------------
# Published versions that later runs must never overwrite (empty by default).
FT_FROZEN_VERSIONS=
