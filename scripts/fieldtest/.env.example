# Field-test environment. Copy to `.env` and edit.
# Results are written to field-test/<FT_VERSION>/results/<run-id>/.

# --- version / results root ---------------------------------------------------
FT_VERSION=v0.1.0

# --- local LLM: OMLX on the host (OpenAI-compatible, Anthropic path for Claude) --
# No hosted model is used. The pinned model is the agentpolicy field-test pin:
# the fastest OMLX model that reliably emits tool calls (see FIELD_TEST_PLAN §4).
FT_LLM_HOST_URL=http://127.0.0.1:8000
FT_LLM_BASE_URL=http://127.0.0.1:8000/v1
FT_LLM_MODEL=Qwen3-4B-Instruct-2507-4bit
# Tier-1 proxy upstream (Claude Code / Codex CLI -> t1_proxy.py -> OMLX).
FT_T1_UPSTREAM=http://127.0.0.1:8000
FT_T1_MODEL=Qwen3-4B-Instruct-2507-4bit

# --- image pin ----------------------------------------------------------------
FT_TAG=local

# --- stack behavior -----------------------------------------------------------
STACK_TIMEOUT=180
STACK_KEEP=0
# 1 = the Docker SUT is required. agentinbox cases run inside the container so
# every case has one reproducible environment.
FT_DOCKER=1
# 1 = drop the container + volume before each SUITE (cases within a suite share
# one SUT). 0 = deliberately keep state across suites while debugging.
FT_CLEAN_SLATE=1

# --- deep verification --------------------------------------------------------
# FT_STRICT_GROUNDING=1 (default): a PASS with no grounded assertion fails.
FT_STRICT_GROUNDING=1
# FT_STRICT_BLOCKED=1 (default): a BLOCKED case makes run-all exit non-zero,
# because a release cannot be tagged while a required field case is blocked.
FT_STRICT_BLOCKED=1

# --- freeze guard -------------------------------------------------------------
# Published versions that later runs must never overwrite (empty by default).
FT_FROZEN_VERSIONS=
